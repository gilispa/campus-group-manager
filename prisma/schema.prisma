generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum StudentLevel {
  PREPA
  PROFESIONAL
}

model Student {
  id             String         @id @default(cuid())
  nombre         String
  matricula      String         @unique
  nivel          StudentLevel
  careerId       String?
  prepaProgramId String?
  generacion     Int?
  academicPending Boolean       @default(false)
  foto           String?
  telefono       String?
  email          String?
  notas          String?
  activo         Boolean        @default(true)
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  career         Career?        @relation(fields: [careerId], references: [id], onDelete: SetNull)
  prepaProgram   PrepaProgram?  @relation(fields: [prepaProgramId], references: [id], onDelete: SetNull)
  memberships    StudentGroup[]
  resolvedPendingMemberships PendingMembership[]

  @@index([nombre])
  @@index([nivel])
  @@index([generacion])
  @@index([careerId])
  @@index([prepaProgramId])
  @@index([deletedAt])
}

model Group {
  id                 String                 @id @default(cuid())
  nombre             String
  descripcion        String?
  logo               String?
  giroId             String?
  portfolioId        String?
  deletedAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  giro               Giro?                  @relation(fields: [giroId], references: [id], onDelete: SetNull)
  portfolio          Portfolio?             @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  memberships        StudentGroup[]
  managementCycles   GroupManagementCycle[]
  pendingMemberships PendingMembership[]

  @@index([nombre])
  @@index([giroId])
  @@index([portfolioId])
  @@index([deletedAt])
}

model Giro {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  groups      Group[]
}

model Portfolio {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  groups      Group[]
}

model Role {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  memberships StudentGroup[]
  pendingMemberships PendingMembership[]
}

model Career {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  students    Student[]
}

model PrepaProgram {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  students    Student[]
}

model StudentGroup {
  id                String                @id @default(cuid())
  studentId         String
  groupId           String
  roleId            String?
  managementCycleId String?
  joinedAt          DateTime              @default(now())
  leftAt            DateTime?
  active            Boolean               @default(true)
  student           Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group             Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role              Role?                 @relation(fields: [roleId], references: [id], onDelete: SetNull)
  managementCycle   GroupManagementCycle? @relation(fields: [managementCycleId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([groupId])
  @@index([roleId])
  @@index([managementCycleId])
  @@index([active])
  @@index([studentId, active])
  @@index([groupId, active])
}

model GroupManagementCycle {
  id                 String              @id @default(cuid())
  groupId            String
  label              String?
  effectiveAt        DateTime            @default(now())
  createdAt          DateTime            @default(now())
  group              Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberships        StudentGroup[]
  pendingMemberships PendingMembership[]

  @@index([groupId])
  @@index([effectiveAt])
}

enum PendingMembershipStatus {
  PENDING
  RESOLVED
  CANCELLED
}

model PendingMembership {
  id                String                  @id @default(cuid())
  matricula         String
  nombre            String?
  groupId           String
  roleId            String?
  roleName          String?
  joinedAt          DateTime?
  managementCycleId String?
  status            PendingMembershipStatus @default(PENDING)
  resolvedAt        DateTime?
  resolvedStudentId String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  group             Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role              Role?                   @relation(fields: [roleId], references: [id], onDelete: SetNull)
  managementCycle   GroupManagementCycle?   @relation(fields: [managementCycleId], references: [id], onDelete: SetNull)
  resolvedStudent   Student?                @relation(fields: [resolvedStudentId], references: [id], onDelete: SetNull)

  @@index([matricula])
  @@index([groupId])
  @@index([status])
  @@index([resolvedStudentId])
}

model AdminSettings {
  id           String   @id @default(cuid())
  singletonKey Int      @unique @default(1)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
